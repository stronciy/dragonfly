// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  performer
  admin
}

enum TaxSystem {
  group1
  group2
  group3
  general
}

model User {
  id           String   @id @default(cuid())
  role         UserRole @default(customer)
  name         String
  email        String   @unique
  phone        String?  @db.VarChar(32)
  passwordHash String   @map("password_hash")

  biometricsEnabled Boolean @default(false) @map("biometrics_enabled")
  twoFactorSecret   String? @map("two_factor_secret")
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at")

  sessionVersion Int @default(0) @map("session_version")

  avatarUrl       String?   @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customerProfile  CustomerProfile?
  performerProfile PerformerProfile?
  legalProfile     LegalProfile?

  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  authoredReviews Review[] @relation("AuthoredReviews")
  performerReviews Review[] @relation("PerformerReviews")
  customerReviews Review[] @relation("CustomerReviews")
  orders         Order[]
  devices        Device[]
  notifications  Notification[]
  orderMedia     OrderMedia[]
  earlyStartRequests EarlyStartRequest[] @relation("RequestedEarlyStarts")
  authoredResolutions ArbitrationResolution[] @relation("ProposedResolutions")
  openedArbitrationCases ArbitrationCase[] @relation("OpenedArbitrationCases")
  arbitrationMessagesUser ArbitrationMessage[] @relation("UserArbitrationMessages")
  progressUpdates WorkProgressUpdate[]

  /// USR-4: блокировка администратором (см. admin_audit_logs).
  blockedAt      DateTime? @map("blocked_at")
  blockedReason  String?   @map("blocked_reason")

  @@map("users")
}

/// Администратор админ-панели: вход у панели свой, в маркетплейсе эти записи
/// не участвуют (в отличие от User с ролью admin).
model Admin {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               String    @default("admin")
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// Bumped on password reset/password change so old panel sessions die.
  sessionVersion     Int       @default(0) @map("session_version")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  passwordResetTokens AdminPasswordResetToken[]
  assignedArbitrationCases ArbitrationCase[] @relation("AssignedArbitrationCases")
  authoredRulings     ArbitrationRuling[]
  authoredArbitrationMessages ArbitrationMessage[] @relation("AdminArbitrationMessages")

  @@map("admins")
}

/// Одноразовые коды восстановления пароля администратора панели.
/// Хранится только SHA-256 от кода; сам код уходит письмом.
model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("admin_password_reset_tokens")
}

/// AUD-1: журнал действий администраторов. Одна запись на мутирующий запрос.
/// Без FK на admins — удаление администратора не должно стирать его действия.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  adminEmail String   @map("admin_email")
  /// `<entity>.<verb>`: user.block, user.update, user.revoke_sessions…
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  reason     String?
  /// Только затронутые поля, без секретов.
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  companyName  String? @map("company_name")
  companyEdrpou String? @map("company_edrpou")
  billingEmail String? @map("billing_email")
  iban         String? @map("iban")
  taxSystem    TaxSystem? @map("tax_system")
  vatPayer     Boolean @default(false) @map("vat_payer")
  legalAddress String? @map("legal_address")
  riskScore    Int     @default(0) @map("risk_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields Field[]
  cropStats CustomerCropStat[]

  @@map("customer_profiles")
}

model Review {
  id String @id @default(cuid())

  orderId         String @map("order_id")
  performerUserId String? @map("performer_user_id")
  customerUserId  String? @map("customer_user_id")
  authorUserId    String @map("author_user_id")

  rating Int
  text   String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  performer User? @relation("PerformerReviews", fields: [performerUserId], references: [id], onDelete: Cascade)
  customer  User? @relation("CustomerReviews", fields: [customerUserId], references: [id], onDelete: Cascade)
  author    User  @relation("AuthoredReviews", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([performerUserId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([orderId, authorUserId])
  @@map("reviews")
}

model CustomerCropStat {
  id             String @id @default(cuid())
  customerUserId String @map("customer_user_id")
  season         Int
  cropId         String @map("crop_id")
  areaHa         Float  @map("area_ha")
  yieldT         Float? @map("yield_t")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer CustomerProfile @relation(fields: [customerUserId], references: [userId], onDelete: Cascade)
  crop     Crop            @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([customerUserId, season, cropId], name: "uniq_cropstat_customer_season_crop")
  @@index([customerUserId, season])
  @@map("customer_crop_stats")
}

model PerformerProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  companyName  String? @map("company_name")
  edrpou       String? @map("edrpou")
  billingEmail String? @map("billing_email")
  iban         String? @map("iban")
  taxSystem    TaxSystem? @map("tax_system")
  vatPayer     Boolean @default(false) @map("vat_payer")
  legalAddress String? @map("legal_address")
  
  baseLocationLabel String? @map("base_location_label")
  baseLatitude      Float?  @map("base_latitude")
  baseLongitude     Float?  @map("base_longitude")

  coverageMode      String? @default("radius") @map("coverage_mode")
  coverageRadiusKm  Int?    @default(50) @map("coverage_radius_km")

  avgRating    Float   @default(0) @map("avg_rating")
  reviewCount  Int     @default(0) @map("review_count")

  services PerformerService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("performer_profiles")
}

model PerformerService {
  id               String  @id @default(cuid())
  performerUserId  String  @map("performer_user_id")
  serviceId        String  @map("service_id")
  serviceLevel     Int     @default(3) @map("service_level")
  specs            Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  performer PerformerProfile @relation(fields: [performerUserId], references: [userId], onDelete: Cascade)

  @@unique([performerUserId, serviceId], name: "uniq_performer_service")
  @@index([performerUserId])
  @@index([serviceId])
  @@map("performer_services")
}

model Field {
  id          String   @id @default(cuid())
  ownerUserId String   @map("owner_user_id")
  name        String
  areaHa      Float    @map("area_ha")
  addressLabel String? @map("address_label")
  lat         Float?
  lng         Float?

  points Json? // List of {lat, lng}

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner CustomerProfile @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("fields")
}

model Order {
  id                   String   @id @default(cuid())
  customerUserId       String   @map("customer_user_id")
  performerUserId      String?  @map("performer_user_id")

  serviceCategoryId    String   @map("service_category_id")
  serviceSubCategoryId String   @map("service_subcategory_id")
  serviceTypeId        String?  @map("service_type_id")
  
  specs                Json     @default("{}")

  areaHa               Float    @map("area_ha")
  dateFrom             DateTime? @map("date_from")
  dateTo               DateTime? @map("date_to")
  
  locationLabel        String   @map("location_label")
  regionName           String?  @map("region_name")
  settlementName       String?  @map("settlement_name")
  orderNumber          String?  @unique @map("order_number")
  lat                  Float
  lng                  Float

  comment              String?  @db.Text
  budget               Decimal  @db.Decimal(12, 2)
  currency             String   @default("UAH")
  
  status               String   @default("published") // draft, published, accepted, requires_confirmation, confirmed, started, completed, arbitration, cancelled
  
  radiusKm             Int?     @map("radius_km")
  acceptedAt           DateTime? @map("accepted_at")
  completedAt          DateTime? @map("completed_at")
  depositDeadline      DateTime? @map("deposit_deadline")
  enRouteAt            DateTime? @map("en_route_at")
  customerPart2Deadline DateTime? @map("customer_part2_deadline")
  paymentPaused        Boolean   @default(false) @map("payment_paused")

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  customer User @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  statusEvents OrderStatusEvent[]
  matches      OrderMatch[]
  reviews      Review[]
  paymentIntents PaymentIntent[]
  escrowLocks    EscrowLock[]
  media          OrderMedia[]
  earlyStartRequests EarlyStartRequest[]
  progressUpdates WorkProgressUpdate[]
  arbitrationResolutions ArbitrationResolution[]
  arbitrationCases ArbitrationCase[]

  @@index([customerUserId, status, createdAt])
  @@index([performerUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([serviceCategoryId, serviceSubCategoryId, serviceTypeId])
  @@map("orders")
}

model ServiceCategory {
  id    String @id @default(cuid())
  name  String
  nameUa String? @map("name_ua")
  iconKey String? @map("icon_key")
  sort  Int    @default(0)

  subcategories ServiceSubcategory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sort, name])
  @@map("service_categories")
}

model ServiceSubcategory {
  id         String @id @default(cuid())
  categoryId String @map("category_id")
  name       String
  nameUa     String? @map("name_ua")
  iconKey String? @map("icon_key")
  sort       Int    @default(0)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  types    ServiceType[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId, sort, name])
  @@map("service_subcategories")
}

model ServiceType {
  subcategoryId String @map("subcategory_id")
  id            String
  name          String
  nameUa        String? @map("name_ua")
  sort          Int    @default(0)

  subcategory ServiceSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([subcategoryId, id])
  @@index([subcategoryId, sort, name])
  @@map("service_types")
}

model Crop {
  id      String @id @default(cuid())
  name    String @unique
  nameUa  String? @map("name_ua")
  group   String? // grain, tech, etc
  iconKey String? @map("icon_key")
  sort    Int     @default(0)

  stats   CustomerCropStat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crops")
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  status    String?  @map("status")
  note      String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_events")
}

model OrderMatch {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  performerUserId String   @map("performer_user_id")
  
  status          String   @default("pending") // pending, ignored, matched
  
  createdAt       DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([performerUserId, orderId], name: "uniq_performer_order_match")
  @@index([performerUserId, createdAt])
  @@index([orderId])
  @@map("order_matches")
}

model Device {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  expoPushToken  String    @unique @map("expo_push_token")
  platform       String?   @map("platform")
  deviceId       String?   @map("device_id")
  appVersion     String?   @map("app_version")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String?
  title     String
  message   String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum OrderMediaKind {
  report
  arbitration
  progress
}

model OrderMedia {
  id        String        @id @default(cuid())
  orderId   String        @map("order_id")
  userId    String        @map("user_id")
  kind      OrderMediaKind
  name      String?
  mimeType  String?       @map("mime_type")
  size      Int?
  url       String        @db.Text
  caption   String?       @db.Text
  progressId String?      @map("progress_id")
  arbitrationMessageId String? @map("arbitration_message_id")
  createdAt DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress WorkProgressUpdate? @relation(fields: [progressId], references: [id], onDelete: Cascade)
  arbitrationMessage ArbitrationMessage? @relation("ArbitrationMessageMedia", fields: [arbitrationMessageId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([progressId])
  @@index([arbitrationMessageId, createdAt])
  @@map("order_media")
}

model EarlyStartRequest {
  id            String   @id @default(cuid())
  orderId       String   @map("order_id")
  requestedById String   @map("requested_by_id")
  status        String   @default("pending") // pending, approved, rejected, withdrawn
  reason        String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  decidedAt     DateTime? @map("decided_at")

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestedEarlyStarts", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("early_start_requests")
}

model WorkProgressUpdate {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  authorId  String   @map("author_id")
  percent   Int?
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media  OrderMedia[]

  @@index([orderId, createdAt])
  @@map("work_progress_updates")
}

model ArbitrationResolution {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  proposedById String  @map("proposed_by_id")
  decision    String   // close_plain, close_fine
  status      String   @default("pending") // pending, approved, rejected, withdrawn
  reason      String?  @db.Text
  rating      Int?
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  decidedAt   DateTime? @map("decided_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proposedBy User @relation("ProposedResolutions", fields: [proposedById], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("arbitration_resolutions")
}

model ArbitrationCase {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  openedByUserId String @map("opened_by_user_id")
  status       String   @default("open") // open, admin_assigned, resolved, closed
  assigneeAdminId String? @map("assignee_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  closedAt     DateTime? @map("closed_at")

  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy       User  @relation("OpenedArbitrationCases", fields: [openedByUserId], references: [id], onDelete: Cascade)
  assigneeAdmin  Admin? @relation("AssignedArbitrationCases", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
  messages       ArbitrationMessage[] @relation("ArbitrationCaseMessages")
  ruling         ArbitrationRuling?

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([assigneeAdminId, status])
  @@map("arbitration_cases")
}

model ArbitrationMessage {
  id            String   @id @default(cuid())
  arbitrationCaseId String @map("arbitration_case_id")
  userId        String?  @map("user_id")
  adminId       String?  @map("admin_id")
  text          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  arbitrationCase ArbitrationCase @relation("ArbitrationCaseMessages", fields: [arbitrationCaseId], references: [id], onDelete: Cascade)
  user            User?  @relation("UserArbitrationMessages", fields: [userId], references: [id], onDelete: SetNull)
  admin           Admin? @relation("AdminArbitrationMessages", fields: [adminId], references: [id], onDelete: SetNull)
  media           OrderMedia[] @relation("ArbitrationMessageMedia")

  @@index([arbitrationCaseId, createdAt])
  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@map("arbitration_messages")
}

model ArbitrationRuling {
  id                String   @id @default(cuid())
  arbitrationCaseId String   @map("arbitration_case_id")
  adminId           String   @map("admin_id")
  decision          String   // close_plain, close_fine
  reason            String?  @db.Text
  rating            Int?
  comment           String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  arbitrationCase ArbitrationCase @relation(fields: [arbitrationCaseId], references: [id], onDelete: Cascade)
  admin           Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([arbitrationCaseId], name: "uniq_arbitration_case_ruling")
  @@index([adminId, createdAt])
  @@map("arbitration_rulings")
}

model LegalProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  companyName    String?  @map("company_name")
  edrpou         String?  @map("edrpou")
  iban           String?  @map("iban")
  legalAddress   String?  @map("legal_address")
  vatPayer       Boolean  @default(false) @map("vat_payer")
  verifiedAt       DateTime? @map("verified_at")
  verifiedByUserId String?   @map("verified_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("legal_profiles")
}

model PaymentIntent {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  role            String   @map("role") // performer, customer
  part            Int      @default(1) @map("part") // 1 = performer full OR customer part1; 2 = customer part2
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("UAH")
  provider        String   @default("liqpay")
  status          String   @default("pending") // pending, paid, failed, expired
  providerOrderId String?  @map("provider_order_id")
  data            String?  @db.Text
  signature       String?  @db.Text
  serverUrl       String?  @map("server_url")
  resultUrl       String?  @map("result_url")
  providerRaw     Json?    @map("provider_raw")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Fee tracking (customer deposit + 8.5% fee)
  depositAmount   Decimal? @db.Decimal(12, 2) @map("deposit_amount")
  feeAmount       Decimal  @default(0) @db.Decimal(12, 2) @map("fee_amount")
  feeRate         Float?   @map("fee_rate")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payment_intents")
}

model EscrowLock {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  userId     String   @map("user_id")
  role       String   @map("role") // performer, customer
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("held") // held, released, refunded
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, role], name: "uniq_order_role_lock")
  @@index([userId])
  @@map("escrow_locks")
}

model OrderNumberCounter {
  serviceCode String @map("service_code")
  yy          Int
  lastSeq     Int    @default(0) @map("last_seq")

  @@id([serviceCode, yy])
  @@map("order_number_counters")
}

